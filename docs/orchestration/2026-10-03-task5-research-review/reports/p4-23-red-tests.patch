+test('containedFolder walks only below the data folder: a link above it is accepted, a link at any folder below it is refused', async () => {
+  // Guard: the walk starts at the data folder, as the engine's containedReviewWorkspace does (mutation: walk from the
+  // filesystem root again, which refuses the linked parent).
+  const base = await fresh(); const real = join(base, 'real-parent'); const linked = join(base, 'linked-parent');
+  await mkdir(join(real, 'data', 'research-kit', 'storage', 'review', 'job-1', 'project'), { recursive: true });
+  await symlink(real, linked, 'junction');
+  // The data folder is reached through a link above it, as /home -> var/home or a C:\Users junction would be.
+  const data = join(linked, 'data'); const reviewRoot = join(data, 'research-kit', 'storage', 'review');
+  expect(await containedFolder(data, reviewRoot, 'job-1', { project: true })).toEqual({ job: join(reviewRoot, 'job-1'), project: join(reviewRoot, 'job-1', 'project') });
+  expect(await containedFolder(data, reviewRoot, 'job-1', { project: false })).toMatchObject({ job: join(reviewRoot, 'job-1') });
+  // A review root outside the data folder is never contained.
+  await expect(containedFolder(join(data, 'research-kit'), join(base, 'review'), 'job-1', { project: false })).rejects.toThrow('PATH_OUTSIDE_PROJECT');
+  // A link at each folder below the data folder: that folder moved aside and linked back, so realpath alone would agree.
+  const realData = join(real, 'data');
+  for (const below of ['research-kit', 'research-kit/storage', 'research-kit/storage/review', 'research-kit/storage/review/job-1', 'research-kit/storage/review/job-1/project']) {
+    const folder = join(realData, ...below.split('/')); const aside = join(base, `aside-${below.replaceAll('/', '-')}`);
+    await rename(folder, aside); await symlink(aside, folder, 'junction');
+    await expect(containedFolder(data, reviewRoot, 'job-1', { project: true }), below).rejects.toThrow('PATH_OUTSIDE_PROJECT');
+    await unlink(folder); await rename(aside, folder);
+    expect(await containedFolder(data, reviewRoot, 'job-1', { project: true }), below).toMatchObject({ job: join(reviewRoot, 'job-1') });
+  }
+});
