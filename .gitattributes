# Historical research ledgers and snapshots must keep their original hashed bytes on every platform.
# Preserve original whitespace too; integrity is checked against the manifest.
docs/handoff/work/** -text -whitespace
docs/handoff/outputs/** -text -whitespace
docs/handoff/manifest.json text eol=lf
research/raw/** -text -whitespace

docs/specification/proposals/*.txt -text
tests/fixtures/research-kit/*.zip -text

# SQL fixtures are compared as text with schema SQL built from LF template literals; a CRLF checkout must not alter them.
tests/fixtures/*.sql text eol=lf
